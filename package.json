{
  "name": "fleet",
  "productName": "fleet",
  "version": "0.1.0",
  "description": "One dashboard for every AI token and dollar across all your machines.",
  "license": "MIT",
  "author": "bishesha",
  "homepage": "https://github.com/bisheshabramhacharya/fleet",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build:ui": "vite build",
    "build:main": "node scripts/build-main.mjs",
    "build": "npm run build:ui && npm run build:main",
    "dev:ui": "vite",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder --publish never",
    "cli": "node dist/cli.cjs"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
